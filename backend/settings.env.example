# Optional backend settings; export variables before starting uvicorn.
# GRASSROOT_* takes precedence over the corresponding legacy CA_* variable.
GRASSROOT_ROBOT=sim
GRASSROOT_ROBOT_URL=ws://192.168.4.1:81/
GRASSROOT_CARDS=fixture
GRASSROOT_CARD_CAMERA=0
GRASSROOT_TRACKER=sim
GRASSROOT_TRACK_CAMERA=1
# GRASSROOT_DATA_DIR=/absolute/path/to/data
# Existing two-index defaults are compatibility settings, not camera handoff.

# Full implementation (optional integrations remain opt-in)
GRASSROOT_STORAGE=sqlite
GRASSROOT_OCR=manual
# GRASSROOT_OCR=local  # install requirements-ocr.txt; cache weights before going offline
# GRASSROOT_JOYSTICK_PORT=/dev/cu.usbmodem...
GRASSROOT_THEME_MODEL=gemini-nano-banana-2.1
# Set GEMINI_API_KEY in your shell/backend environment, never in this file or frontend.
